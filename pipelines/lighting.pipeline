descriptorSet {
	addBinding(0, combinedSampler, fragment)
	addBinding(1, combinedSampler, fragment)
	addBinding(2, combinedSampler, fragment)
	addBinding(3, uniformBuffer, vertex|fragment)
	addBinding(4, uniformBuffer, vertex|fragment)
}

pipeline {
	addStage(base64"", vertex)
	addStage(base64"", fragment)

	subpass(0)
	depthTest(true)
	cullMode(back)
	depthCompareOp(greaterOrEqual)
	rasterizationSamples(4)

	addVertexBinding(0, 112, perVertex)
	addVertexAttribute(0, 0, rgba32_sfloat, 0)		// Position
	addVertexAttribute(1, 0, rgba32_sfloat, 16)		// UV
	addVertexAttribute(2, 0, rgba32_sfloat, 32)		// Tangnet
	addVertexAttribute(3, 0, rgba32_sfloat, 48)		// Binormal
	addVertexAttribute(4, 0, rgba32_sfloat, 64)		// Normal
	addVertexAttribute(5, 0, rgba32_uint, 80)		// Bone index
	addVertexAttribute(6, 0, rgba32_sfloat, 96)		// Bone weight

	addVertexBinding(1, 80, perInstance)
	addVertexAttribute(7,  1, rgba32_sfloat, 0)		// Transform matrix (x)
	addVertexAttribute(8,  1, rgba32_sfloat, 16)	// Transform matrix (y)
	addVertexAttribute(9,  1, rgba32_sfloat, 32)	// Transform matrix (z)
	addVertexAttribute(10, 1, rgba32_sfloat, 48)	// Transform matrix (w)
	addVertexAttribute(11, 1, rgba32_uint, 64)		// Animation palette offset (plus padding)
}
