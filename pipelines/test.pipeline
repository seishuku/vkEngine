descriptorSet {
	addBinding(0, uniformBuffer, vertex|fragment)
	addBinding(1, uniformBuffer, vertex)
	addBinding(2, uniformBuffer, vertex)
}

pipeline {
	addStage(base64"", vertex)
	addStage(base64"", fragment)

	subpass(0)
	depthTest(true)
	cullMode(back)
	depthCompareOp(greaterOrEqual)
	rasterizationSamples(4)

	addVertexBinding(0, 112, perVertex)
	addVertexAttribute(0, 0, rgba32_sfloat, 0)
	addVertexAttribute(1, 0, rgba32_sfloat, 16)
	addVertexAttribute(2, 0, rgba32_sfloat, 32)
	addVertexAttribute(3, 0, rgba32_sfloat, 48)
	addVertexAttribute(4, 0, rgba32_sfloat, 64)
	addVertexAttribute(5, 0, rgba32_sfloat, 80)
	addVertexAttribute(6, 0, rgba32_sfloat, 96)
}
