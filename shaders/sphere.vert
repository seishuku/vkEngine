layout(push_constant) uniform ubo
{
	mat4 mvp;
	vec4 color;
};

out gl_PerVertex
{
    vec4 gl_Position;
};

layout(location=0) out vec4 Color;

void main()
{
	vec4 v=ico[gl_VertexIndex];

	Color=vec4(color.xyz*normalize(v.xyz*0.5+0.5), 1.0);

	v.y+=v.w*color.w;

	gl_Position=mvp*vec4(v.xyz, 1.0);
}
